<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Trim/AOT analyzers always on for libs; AOT publish flags live on src/Nexus.Cli only">
    <!-- Note: IsTrimmable on user assemblies is intentionally false so partial-
         trim leaves our own code intact. The trim analyzer still runs (catches
         IL2026/IL3050 in our code at compile time) without aggressive trim at
         publish time. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Repository metadata">
    <Authors>Grigoris Zapantis</Authors>
    <Company>NexusPlatform</Company>
    <Copyright>Copyright (c) 2026 Grigoris Zapantis</Copyright>
    <RepositoryUrl>https://github.com/grezap/nexus-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
